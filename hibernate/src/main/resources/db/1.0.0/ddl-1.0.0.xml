<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="pkonyha" id="create-comment-id-sequence">
        <comment>Create sequence for comment id.</comment>
        <createSequence sequenceName="comment_id_sequence"
                        cycle="false"
                        incrementBy="1"
                        minValue="100"
                        startValue="101"/>
    </changeSet>
    <changeSet author="pkonyha" id="create-post-id-sequence">
        <comment>Create sequence for post id.</comment>
        <createSequence sequenceName="post_id_seq"
                        cycle="false"
                        incrementBy="1"
                        minValue="100"
                        startValue="101"/>
    </changeSet>

    <changeSet author="pkonyha" id="1444232542055-4">
        <comment>Create table post.</comment>
        <createTable tableName="post">
            <column name="id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="author" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="VARCHAR(4000)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet author="pkonyha" id="1444232542055-3">
        <comment>Create table comment.</comment>
        <createTable tableName="comment">
            <column name="id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="author" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="VARCHAR(4000)">
                <constraints nullable="false"/>
            </column>
            <column name="post_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="pkonyha" id="create-pk-comment">
        <comment>Add primary key constraint on table comment.</comment>
        <addPrimaryKey columnNames="id" constraintName="comment_pkey" tableName="comment"/>
    </changeSet>
    <changeSet author="pkonyha" id="create-pk-post">
        <comment>Add primary key constraint on table post.</comment>
        <addPrimaryKey columnNames="id" constraintName="post_pkey" tableName="post"/>
    </changeSet>
</databaseChangeLog>