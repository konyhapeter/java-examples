type Query {
    getAllBook: [Book]
    bookById(id: ID): Book!
}
type Mutation {
    addBookToAuthor(bookRequest: BookInput): Author!
}
input BookInput {
    id: ID
    name: String
    pageCount: Int
    authorId: String
}

type Subscription {
    bookAdded: Message!
}

type Message {
    id: ID!
    text: String!
}


type Book {
    id: ID
    name: String
    pageCount: Int
    author: Author
}

type Author {
    id: ID
    firstName: String
    lastName: String
    books: [Book]
}